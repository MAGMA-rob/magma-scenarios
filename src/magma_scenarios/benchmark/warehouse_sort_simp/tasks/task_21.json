            "keys_evaluator": [
                "c-reasoning"
            ]
        },
        {
            "instruction": "Why?",
            "expected_behavior": "answer",
            "complementary_verif": {
                "judge": "The model must answer that it is because it has an order in its memory to not use area2."
            },
            "keys_evaluator": [
                "lg-memorization"
            ]
        },
        {
            "instruction": "Okay, so use area1 instead",
            "max_step": 1,
            "action_goal": [
                {
                    "predicate": "in",
                    "arguments": {
                        "obj_name": "ref_obj_*",
                        "location": "area1"
                    }
                }
            ],
            "complementary_verif": {},
            "should_reset_env": true,
            "keys_evaluator": [
                "lg-memorization"
            ]
        }
