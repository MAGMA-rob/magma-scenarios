                },
                {
                    "predicate": "in",
                    "arguments": {
                        "obj_name": "ref_obj_3",
                        "location": "area1"
                    }
                },
                {
                    "predicate": "not_in",
                    "arguments": {
                        "obj_name": "ref_obj_2",
